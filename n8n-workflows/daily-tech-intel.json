{
  "name": "Daily Tech Intelligence",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "10 19 * * *"
            }
          ]
        }
      },
      "id": "1c0b0a64-6d44-47de-95fa-a1a6fda5ff01",
      "name": "Every day 19:10",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8020/run-daily",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={\"request_id\":\"{{$execution.id}}\"}",
        "options": {
          "timeout": 900000
        }
      },
      "id": "ae8ad0d7-bfea-4bcf-bbff-c578a10135d1",
      "name": "Generate Daily Digest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const result = $json;\nif (!result.ok || result.status !== 'succeeded') {\n  throw new Error(`Daily digest failed: ${result.failed_stage || result.error || 'unknown error'}`);\n}\nreturn [{ json: {\n  request_id: result.request_id,\n  run_id: result.run_id,\n  pipeline: result.pipeline,\n  status: result.status,\n  retryable: result.retryable,\n  manifest: result.manifest,\n  article_review_url: result.article_review_url,\n  platform_pack_url: result.platform_pack_url,\n  preview_url: result.preview_url\n} }];"
      },
      "id": "8c3a9345-0ac7-4c0f-8b4b-8bd7d6c44e5e",
      "name": "Validate Daily Digest Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        0
      ]
    }
  ],
  "connections": {
    "Every day 19:10": {
      "main": [
        [
          {
            "node": "Generate Daily Digest",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Daily Digest": {
      "main": [
        [
          {
            "node": "Validate Daily Digest Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "timezone": "Asia/Shanghai"
  }
}
