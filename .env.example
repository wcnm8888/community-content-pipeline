POSTGRES_USER=n8n
POSTGRES_PASSWORD=please_change_this_password
POSTGRES_DB=n8n

N8N_PORT=5860
RSSHUB_PORT=1200
TIMEZONE=Asia/Shanghai
N8N_ENCRYPTION_KEY=replace_with_at_least_32_random_characters

# DeepSeek official OpenAI-compatible endpoint.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=sk-your-deepseek-key

# Optional. MVP can use Jina Reader without a key.
JINA_READER_BASE_URL=https://r.jina.ai/

# Optional. Knowledge share search. If this is not configured, use --urls mode.
# Brave Web Search uses REST JSON and the X-Subscription-Token header:
# https://api-dashboard.search.brave.com/documentation
# https://api-dashboard.search.brave.com/app/documentation/web-search/get-started
SEARCH_PROVIDER=brave
SEARCH_API_KEY=your-search-api-key
SEARCH_BASE_URL=https://api.search.brave.com/res/v1/web/search
